[Desktop Entry]
Type=Application
Name=Froditor
GenericName=Text Editor
GenericName[nn]=Tekstbehandlar
GenericName[nb]=Tekstbehandler
Comment=Simple editor for text files and PowerShell scripts
Comment[nn]=Enkel tekstbehandlar for tekstfiler og PowerShell-skript
Comment[nb]=Enkel tekstbehandler for tekstfiler og PowerShell-skript
Exec=froditor %F
Icon=no.frodolini.Froditor
Terminal=false
Categories=Utility;TextEditor;GTK;
MimeType=text/plain;
Keywords=text;editor;notepad;txt;
Keywords[nn]=tekst;notat;notisblokk;editor;txt;
Keywords[nb]=tekst;notat;notisblokk;editor;txt;
StartupNotify=true
